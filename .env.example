# Required
API_KEY=change-me-to-a-long-random-string

# mock = local dev without GPU; xtts = Coqui XTTS v2 on GPU (RunPod)
MODEON_TTS_MODE=mock

# XTTS (when MODEON_TTS_MODE=xtts)
MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
DEVICE=cuda
# Optional path on network volume, e.g. /runpod-volume/checkpoints/default
MODEL_PATH=

# Default speaker: maps speaker_id "default" to a reference WAV for cloning
DEFAULT_SPEAKER_WAV=/runpod-volume/voices/default/reference.wav

# Limits
MAX_TEXT_CHARS=500
